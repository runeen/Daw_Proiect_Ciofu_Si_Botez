@model IEnumerable<cbapp.Models.ProjectRatings>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@ViewData["rez"]

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.rating_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.score)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.projectId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.rating_date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.score)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.projectId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td>
            <td>
                    @Html.ActionLink("Details", "Details", new {projectId= item.projectId, UserId = item.UserId}) |
                    @Html.ActionLink("Delete", "Delete", new {projectId= item.projectId, UserId = item.UserId})
            </td>
        </tr>
}
    </tbody>
</table>

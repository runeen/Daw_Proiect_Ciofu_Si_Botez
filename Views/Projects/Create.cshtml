@model cbapp.Models.Project

@{
    ViewData["Title"] = "Create";
}

<hr class="mb-4"/>
<h4 class="d-flex justify-content-center" style="color:darkred ">Adauga un Proiect in baza de date </h4>
<hr class="mb-4"/>
<div class="d-flex justify-content-center align-items-center" >
    <div class="col-md-4"> <!-- Dimensiunea formularului -->
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Artist -->
            <div class="form-group mb-3">
                <label asp-for="artist" class="control-label"></label>
                <input asp-for="artist" class="form-control" />
                <span asp-validation-for="artist" class="text-danger"></span>
            </div>

            <!-- Release Title -->
            <div class="form-group mb-3">
                <label asp-for="release_title" class="control-label"></label>
                <input asp-for="release_title" class="form-control" />
                <span asp-validation-for="release_title" class="text-danger"></span>
            </div>

            <!-- Release Date -->
            <div class="form-group mb-3">
                <label class="" asp-for="release_date" class="control-label"></label>
                <input asp-for="release_date" type="date" class="form-control" />
                <span asp-validation-for="release_date" class="text-danger"></span>
            </div>

            <!-- Type -->
            <div class="form-group mb-3">
                <label asp-for="type" class="control-label"></label>
                
                 <select asp-for="type"  class="form-select">
                 <option value="Single">Single</option>
                <option value="Album">Album</option>
                <option value="EP">EP</option>
                </select>
                <span asp-validation-for="type" class="text-danger"></span>
            </div>

            <!-- Submit button -->
            <div class="d-grid mb-3">
                <input type="submit" value="Continua" class="btn btn-primary" />
            </div>
            
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

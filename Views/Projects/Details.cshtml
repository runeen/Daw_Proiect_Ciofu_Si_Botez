@model cbapp.Models.Project

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Project</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.artist)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.artist)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.release_title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.release_title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.release_date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.release_date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.type)
        </dd>
    </dl>
</div>

<div class="Traklist-div">
    <table class="table">
        <thead>
            <tr>
                <th>
                    title
                </th>
                <th>
                    length
                </th>
                <th>
                    tracklist_number
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Songs)
            {
                <tr>
                    <td>
                        @item.title
                    </td>
                    <td>
                        @item.length
                    </td>
                    <td>
                        @item.tracklist_number
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.project_id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
